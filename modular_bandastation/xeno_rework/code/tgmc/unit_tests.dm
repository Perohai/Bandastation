// Scoped assertions: upstream undefines TEST_ASSERT after its include block.
#define XENO_TGMC_ASSERT(condition, message) if(!(condition)) { return Fail(message, __FILE__, __LINE__) }
#define XENO_TGMC_ASSERT_EQUAL(actual, expected, message) if((actual) != (expected)) { return Fail(message, __FILE__, __LINE__) }

/// Run with the repository's normal UNIT_TESTS configuration.
/// These exercise resource accounting, obstruction and overlapping buff cleanup.
/datum/unit_test/xeno_tgmc_spit_accounting/Run()
	var/mob/living/carbon/alien/adult/banda/spitter/caster = allocate(__IMPLIED_TYPE__, run_loc_floor_bottom_left)
	var/mob/living/carbon/human/consistent/victim = allocate(__IMPLIED_TYPE__, get_step(run_loc_floor_bottom_left, EAST))
	var/obj/item/organ/alien/plasmavessel/vessel = caster.get_organ_by_type(/obj/item/organ/alien/plasmavessel)
	caster.adjustPlasma(vessel.max_plasma)
	var/datum/action/cooldown/alien/banda/tgmc/acid_spit/spit = locate() in caster.actions
	XENO_TGMC_ASSERT(spit, "Spitter did not receive Acid Spit through its organ")
	var/before = caster.getPlasma()
	XENO_TGMC_ASSERT(spit.PreActivate(victim), "Valid acid spit was rejected")
	XENO_TGMC_ASSERT_EQUAL(caster.getPlasma(), before - 50, "One shot must consume exactly 50 plasma")
	XENO_TGMC_ASSERT(!spit.PreActivate(victim), "Cooldown must reject an immediate second shot")
	XENO_TGMC_ASSERT_EQUAL(caster.getPlasma(), before - 50, "Rejected shot must not consume plasma")
	spit.ResetCooldown()
	caster.adjustPlasma(-vessel.max_plasma)
	XENO_TGMC_ASSERT(!spit.PreActivate(victim), "Shot without plasma was accepted")
	XENO_TGMC_ASSERT_EQUAL(caster.getPlasma(), 0, "Failed shot changed empty plasma reserve")

/datum/unit_test/xeno_tgmc_toxic_stacks/Run()
	var/mob/living/carbon/human/consistent/victim = allocate(__IMPLIED_TYPE__, run_loc_floor_bottom_left)
	var/mob/living/carbon/alien/adult/banda/sentinel/caster = allocate(__IMPLIED_TYPE__, get_step(run_loc_floor_bottom_left, EAST))
	xeno_tgmc_intoxicate(victim, 5)
	xeno_tgmc_intoxicate(victim, 5)
	var/datum/status_effect/xeno_tgmc_intoxicated/toxin = victim.has_status_effect(/datum/status_effect/xeno_tgmc_intoxicated)
	XENO_TGMC_ASSERT(toxin, "Toxic Spit did not apply intoxication")
	XENO_TGMC_ASSERT_EQUAL(toxin.stacks, 10, "Intoxication must stack on repeated hits")
	toxin.change_stacks(100)
	XENO_TGMC_ASSERT_EQUAL(toxin.stacks, 30, "Intoxication exceeded its TGMC stack cap")
	xeno_tgmc_intoxicate(caster, 5)
	XENO_TGMC_ASSERT(!caster.has_status_effect(/datum/status_effect/xeno_tgmc_intoxicated), "An alien was intoxicated by allied toxin")
	toxin.change_stacks(-30)
	XENO_TGMC_ASSERT(!victim.has_status_effect(/datum/status_effect/xeno_tgmc_intoxicated), "Zero stacks must remove intoxication")

/datum/unit_test/xeno_tgmc_charge_obstruction/Run()
	var/turf/origin = run_loc_floor_bottom_left
	var/turf/blocked = get_step(origin, EAST)
	var/mob/living/carbon/alien/adult/banda/ravager/caster = allocate(__IMPLIED_TYPE__, origin)
	var/mob/living/carbon/human/consistent/victim = allocate(__IMPLIED_TYPE__, blocked)
	allocate(/obj/structure/alien/resin/door, blocked)
	var/obj/item/organ/alien/plasmavessel/vessel = caster.get_organ_by_type(/obj/item/organ/alien/plasmavessel)
	caster.adjustPlasma(vessel.max_plasma)
	var/datum/action/cooldown/alien/banda/tgmc/ravager_charge/charge = locate() in caster.actions
	XENO_TGMC_ASSERT(charge.PreActivate(victim), "Charge did not begin with a valid target and resource")
	XENO_TGMC_ASSERT_EQUAL(get_turf(caster), origin, "Charge crossed a closed door")
	XENO_TGMC_ASSERT_EQUAL(victim.get_brute_loss(), 0, "Charge damaged a victim through a closed door")
	XENO_TGMC_ASSERT(!charge.charge_path, "Blocked charge retained an active path")
	XENO_TGMC_ASSERT(!charge.charge_timer, "Blocked charge retained a timer")

/datum/unit_test/xeno_tgmc_endure_rage_cleanup/Run()
	var/mob/living/carbon/alien/adult/banda/ravager/caster = allocate(__IMPLIED_TYPE__, run_loc_floor_bottom_left)
	caster.adjust_brute_loss(410)
	var/baseline_bomb_armor = caster.getarmor(null, BOMB)
	var/baseline_death_threshold = caster.tgmc_get_dead_threshold()
	var/datum/status_effect/xeno_tgmc_endure/endure = caster.apply_status_effect(/datum/status_effect/xeno_tgmc_endure)
	XENO_TGMC_ASSERT(HAS_TRAIT(caster, TRAIT_NOHARDCRIT), "Endure did not suppress hard crit")
	XENO_TGMC_ASSERT_EQUAL(caster.getarmor(null, BOMB), baseline_bomb_armor + 20, "Endure did not add bomb armor")
	var/datum/status_effect/xeno_tgmc_rage/rage = caster.apply_status_effect(/datum/status_effect/xeno_tgmc_rage)
	XENO_TGMC_ASSERT_EQUAL(rage.power, 0.5, "Rage below zero HP did not receive super-rage power")
	XENO_TGMC_ASSERT_EQUAL(caster.tgmc_get_dead_threshold(), -150, "Super Rage did not empower active Endure")
	XENO_TGMC_ASSERT(HAS_TRAIT(caster, TRAIT_STUNIMMUNE), "Rage did not grant stun immunity")
	qdel(endure)
	XENO_TGMC_ASSERT_EQUAL(caster.tgmc_get_dead_threshold(), baseline_death_threshold, "Endure left an altered death threshold")
	XENO_TGMC_ASSERT_EQUAL(caster.getarmor(null, BOMB), baseline_bomb_armor, "Endure left bomb armor behind")
	XENO_TGMC_ASSERT(HAS_TRAIT(caster, TRAIT_NO_STAGGER), "Removing Endure stripped the overlapping Rage trait")
	XENO_TGMC_ASSERT(caster.stat != DEAD, "A surviving ravager died when base Endure ended")
	qdel(rage)
	XENO_TGMC_ASSERT_EQUAL(caster.melee_damage_upper, initial(caster.melee_damage_upper), "Rage left bonus claw damage behind")
	XENO_TGMC_ASSERT(!HAS_TRAIT(caster, TRAIT_NO_STAGGER), "Rage left stagger immunity behind")
	XENO_TGMC_ASSERT(!HAS_TRAIT(caster, TRAIT_STUNIMMUNE), "Rage left stun immunity behind")

/datum/unit_test/xeno_tgmc_scatter_cancel/Run()
	var/mob/living/carbon/alien/adult/banda/spitter/caster = allocate(__IMPLIED_TYPE__, run_loc_floor_bottom_left)
	var/datum/action/cooldown/alien/banda/tgmc/spray_acid/spray = locate() in caster.actions
	spray.spray_path = list(get_step(run_loc_floor_bottom_left, EAST))
	spray.caster_ref = WEAKREF(caster)
	spray.spray_timer = addtimer(CALLBACK(spray, TYPE_PROC_REF(/datum/action/cooldown/alien/banda/tgmc/spray_acid, advance_spray), run_loc_floor_bottom_left), 1 SECONDS, TIMER_STOPPABLE)
	spray.Remove(caster)
	XENO_TGMC_ASSERT(!spray.spray_path && !spray.spray_timer && !spray.caster_ref, "Removing Spray Acid retained deferred work")

/datum/unit_test/xeno_tgmc_armor_sources/Run()
	var/mob/living/carbon/alien/adult/banda/ravager/caster = allocate(__IMPLIED_TYPE__, run_loc_floor_bottom_left)
	var/baseline = caster.getarmor(null, MELEE)
	caster.set_tgmc_armor("first_test", new /datum/armor/xeno_tgmc_drain_surge)
	caster.set_tgmc_armor("second_test", new /datum/armor/xeno_tgmc_drain_surge)
	XENO_TGMC_ASSERT_EQUAL(caster.getarmor(null, MELEE), baseline + 40, "Independent armor sources did not stack")
	caster.remove_tgmc_armor("first_test")
	XENO_TGMC_ASSERT_EQUAL(caster.getarmor(null, MELEE), baseline + 20, "Removing one armor source removed another")
	caster.set_tgmc_armor("second_test", new /datum/armor/xeno_tgmc_drain_surge)
	XENO_TGMC_ASSERT_EQUAL(caster.getarmor(null, MELEE), baseline + 20, "Refreshing a source duplicated armor")
	caster.remove_tgmc_armor("second_test")
	XENO_TGMC_ASSERT_EQUAL(caster.getarmor(null, MELEE), baseline, "Temporary armor survived removal")

/datum/unit_test/xeno_tgmc_empowered_death_boundary/Run()
	var/mob/living/carbon/alien/adult/banda/ravager/caster = allocate(__IMPLIED_TYPE__, run_loc_floor_bottom_left)
	var/datum/status_effect/xeno_tgmc_endure/endure = caster.apply_status_effect(/datum/status_effect/xeno_tgmc_endure)
	endure.empower()
	caster.adjust_brute_loss(caster.maxHealth + 125)
	XENO_TGMC_ASSERT(caster.stat != DEAD, "Empowered Endure did not protect its extra health range")
	XENO_TGMC_ASSERT(!HAS_TRAIT(caster, TRAIT_NODEATH), "Health-threshold check left death immunity behind")
	caster.adjust_brute_loss(30)
	XENO_TGMC_ASSERT_EQUAL(caster.stat, DEAD, "Empowered Endure allowed survival past its death threshold")

#undef XENO_TGMC_ASSERT
#undef XENO_TGMC_ASSERT_EQUAL
