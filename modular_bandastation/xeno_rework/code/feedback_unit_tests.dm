	TEST_ASSERT(!beetle.charging && (beetle.pass_flags & PASSMOB), "Landed beetle retained its charge collision state")

/datum/unit_test/xeno_rework_hive/caste_permissions/Run()
	for(var/caste in valid_subtypesof(/mob/living/carbon/alien/adult/banda))
		var/mob/living/carbon/alien/adult/banda/member = allocate(caste)
		var/plant_allowed = istype(member, /mob/living/carbon/alien/adult/banda/queen) || istype(member, /mob/living/carbon/alien/adult/banda/drone) || istype(member, /mob/living/carbon/alien/adult/banda/praetorian)
		var/acid_allowed = istype(member, /mob/living/carbon/alien/adult/banda/queen) || istype(member, /mob/living/carbon/alien/adult/banda/praetorian) || istype(member, /mob/living/carbon/alien/adult/banda/final_caste/boiler)
		TEST_ASSERT_EQUAL(!!(locate(/datum/action/cooldown/alien/make_structure/plant_weeds) in member.actions), plant_allowed, "Wrong weed access for [caste]")
		TEST_ASSERT_EQUAL(!!(locate(/datum/action/cooldown/alien/acid/corrosion) in member.actions), acid_allowed, "Wrong wall acid access for [caste]")
		var/datum/action/cooldown/alien/make_structure/plant_weeds/forged = allocate(/datum/action/cooldown/alien/make_structure/plant_weeds)
		forged.Grant(member)
		TEST_ASSERT_EQUAL(forged.IsAvailable(), plant_allowed, "A transplanted vessel bypassed caste weed access for [caste]")
		var/matrix/size = member.transform
		TEST_ASSERT(abs(size.a - member.sprite_scale) < 0.001, "Caste is not shrunk on spawn: [caste]")
		member.update_transform(1.2)
		sleep(0.5 SECONDS)
		size = member.transform
		TEST_ASSERT(abs(size.a - member.sprite_scale * member.current_size) < 0.001, "Native resizing lost the caste shrink: [caste]")
	var/mob/living/carbon/alien/adult/banda/sentinel/sentinel = allocate(/mob/living/carbon/alien/adult/banda/sentinel)
	TEST_ASSERT_EQUAL(sentinel.evolution_tier, 1, "Sentinel is not T1")
	TEST_ASSERT_NULL(sentinel.get_organ_slot(ORGAN_SLOT_XENO_RESINSPINNER), "Sentinel can still build")
	TEST_ASSERT(sentinel.can_evolve(/mob/living/carbon/alien/adult/banda/spitter), "Sentinel cannot evolve into Spitter")
	var/mob/living/carbon/alien/adult/banda/spitter/spitter = allocate(/mob/living/carbon/alien/adult/banda/spitter)
	TEST_ASSERT_EQUAL(spitter.evolution_tier, 2, "Spitter is not T2")
	TEST_ASSERT_EQUAL(spitter.get_max_plasma(), 500, "Spitter lacks its T2 plasma reserve")

/datum/unit_test/xeno_rework_hive/spitter_prices/Run()
	var/mob/living/carbon/alien/adult/banda/spitter/spitter = allocate(/mob/living/carbon/alien/adult/banda/spitter)
	var/datum/action/cooldown/alien/banda/spit/spit = locate() in spitter.actions
	var/datum/action/cooldown/alien/banda/toggle_spit/toggle = locate() in spitter.actions
	TEST_ASSERT_EQUAL(spit.plasma_cost, 20, "Spitter neurotoxin retained its old price")
	toggle.Activate()
	TEST_ASSERT_EQUAL(spit.plasma_cost, 40, "Toggling acid restored the expensive price")
	toggle.Activate()
	TEST_ASSERT_EQUAL(spit.plasma_cost, 20, "Toggling neurotoxin restored the expensive price")
	var/datum/action/cooldown/alien/banda/acid_volley/volley = locate() in spitter.actions
	var/datum/action/cooldown/alien/banda/acid_spray/spray = locate() in spitter.actions
	TEST_ASSERT_EQUAL(volley.plasma_cost, 100, "Spitter volley retained its old price")
	TEST_ASSERT_EQUAL(spray.plasma_cost, 120, "Spitter spray retained its old price")
	var/mob/living/carbon/alien/adult/banda/praetorian/praetorian = allocate(/mob/living/carbon/alien/adult/banda/praetorian)
	var/datum/action/cooldown/alien/banda/acid_spray/cone/cone = locate() in praetorian.actions
	TEST_ASSERT_EQUAL(cone.plasma_cost, 300, "Spitter tuning unintentionally changed Praetorian")

/datum/unit_test/xeno_rework_hive/brood_melee/Run()
	var/mob/living/carbon/human/prey = allocate(/mob/living/carbon/human/consistent)
	for(var/caste in typesof(/mob/living/carbon/alien/brood))
		var/mob/living/carbon/alien/brood/minion = allocate(caste)
		var/before = prey.get_brute_loss()
		minion.UnarmedAttack(prey, TRUE, list())
		TEST_ASSERT_EQUAL(prey.get_brute_loss() - before, minion.melee_damage_upper, "Left-click bite did no damage for [caste]")
		before = prey.get_brute_loss()
		minion.UnarmedAttack(prey, TRUE, list(RIGHT_CLICK = TRUE))
		TEST_ASSERT_EQUAL(prey.get_brute_loss() - before, minion.melee_damage_upper, "Right-click bite was cancelled for [caste]")
		minion.set_resting(TRUE)
		before = prey.get_brute_loss()
		minion.UnarmedAttack(prey, TRUE, list())
		TEST_ASSERT_EQUAL(prey.get_brute_loss(), before, "Resting minion could bite")

/datum/unit_test/xeno_rework_hive/scorpion_spit/Run()
	var/mob/living/carbon/alien/brood/scorpion/scorpion = allocate(/mob/living/carbon/alien/brood/scorpion)
	TEST_ASSERT_EQUAL(scorpion.get_max_plasma(), 500, "Basic scorpion reserve is not 500")
	var/datum/action/cooldown/alien/brood_spit/spit = locate() in scorpion.actions
	TEST_ASSERT_NOTNULL(spit, "Basic scorpion has no spit")
	var/mob/living/carbon/human/prey = allocate(/mob/living/carbon/human/consistent, get_step(scorpion, NORTH))
	for(var/upgraded in list(FALSE, TRUE))
		if(upgraded)
			hive.purchased["scorpion_spit"] = 1
			scorpion.apply_hive_upgrade()
		spit.ResetCooldown()
		scorpion.adjustPlasma(500)
		var/before = prey.get_fire_loss()
		TEST_ASSERT(spit.PreActivate(prey), "Scorpion spit could not fire")
		sleep(1 SECONDS)
		TEST_ASSERT_EQUAL(prey.get_fire_loss() - before, upgraded ? 10 : 5, "Scorpion spit did the wrong damage")
		TEST_ASSERT_EQUAL(scorpion.get_max_plasma(), 500, "Upgrade changed the scorpion cap")

/datum/unit_test/xeno_rework_hive/baneling_warning/Run()
	hive.purchased["brood_baneling"] = 1
	var/mob/living/carbon/alien/brood/baneling/baneling = allocate(/mob/living/carbon/alien/brood/baneling)
	var/datum/action/cooldown/alien/brood_detonate/detonate = locate() in baneling.actions
	TEST_ASSERT_EQUAL(detonate.fuse_time, 1.5 SECONDS, "Baneling default fuse is not 1.5 seconds")
	detonate.fuse_time = 0.5 SECONDS
	TEST_ASSERT(detonate.PreActivate(baneling), "Baneling could not arm its fuse")
	TEST_ASSERT_NOTNULL(baneling.get_filter("baneling_pulse"), "Armed baneling has no full-body pulse")
	TEST_ASSERT(HAS_TRAIT(baneling, TRAIT_IMMOBILIZED), "Arming the fuse did not immobilize the baneling")
	TEST_ASSERT(!(baneling.mobility_flags & MOBILITY_MOVE), "Armed baneling retains voluntary movement")
	TEST_ASSERT(!detonate.PreActivate(baneling), "Repeated activation restarted an armed fuse")
	baneling.forceMove(get_step(baneling, NORTH))
	TEST_ASSERT(detonate.primed, "Movement cancelled the fuse")
	baneling.Paralyze(1 SECONDS)
	sleep(0.8 SECONDS)
	TEST_ASSERT(QDELETED(baneling), "Movement or stun stopped the live baneling exploding")
	var/mob/living/carbon/alien/brood/baneling/killed = allocate(/mob/living/carbon/alien/brood/baneling)
	var/datum/action/cooldown/alien/brood_detonate/killed_fuse = locate() in killed.actions
	killed_fuse.fuse_time = 0.3 SECONDS
	TEST_ASSERT(killed_fuse.PreActivate(killed), "Second baneling could not arm")
	killed.death()
	TEST_ASSERT(!killed_fuse.primed && !killed_fuse.explosion_timer && !killed_fuse.warning_timer, "Death left live fuse callbacks")
	TEST_ASSERT_NULL(killed.get_filter("baneling_pulse"), "Death left a green pulse")
	TEST_ASSERT(!HAS_TRAIT_FROM(killed, TRAIT_IMMOBILIZED, REF(killed_fuse)), "Death left the fuse's immobilization trait")
	sleep(0.5 SECONDS)
	TEST_ASSERT(!QDELETED(killed), "Dead baneling still exploded")

/datum/unit_test/xeno_rework_hive/individual_eggs/Run()
	allocate(/mob/living/carbon/alien/adult/banda/queen)
	allocate(/obj/structure/alien/weeds/node)
	var/obj/structure/xeno_hive_core/core = allocate(/obj/structure/xeno_hive_core)
	STOP_PROCESSING(SSobj, core)
	hive.advance_brood(2000, 60)
	TEST_ASSERT(core.density, "Hive core is still passable")
	TEST_ASSERT_EQUAL(length(core.brood_eggs), 20, "Places were merged into a shared clutch or capped at eight")
	for(var/obj/structure/xeno_hive_egg/egg as anything in core.brood_eggs)
		TEST_ASSERT(core.next_to_core(egg), "A brood egg appeared inside or away from the core footprint")
		TEST_ASSERT_EQUAL(egg.spawner.uses, 1, "An individual egg stores several places")
	var/obj/structure/xeno_hive_egg/removed = core.brood_eggs[1]
	qdel(removed)
	TEST_ASSERT_EQUAL(core.available_brood(), 19, "Destroying one egg lost several places")
	var/obj/structure/xeno_hive_egg/consumed = core.brood_eggs[1]
	consumed.spawner.uses = 0
	consumed.spawner.check_uses()
	TEST_ASSERT(QDELETED(consumed), "Occupied brood egg did not disappear")
	TEST_ASSERT_EQUAL(core.available_brood(), 18, "Claiming one egg lost other places")
	var/list/remaining = core.brood_eggs.Copy()
	qdel(core)
	for(var/obj/structure/xeno_hive_egg/egg as anything in remaining)
		TEST_ASSERT(QDELETED(egg), "Core loss left an unclaimed egg")

/datum/unit_test/xeno_rework_hive/carrier_clingers/Run()
	var/mob/living/carbon/alien/adult/banda/carrier/carrier = allocate(/mob/living/carbon/alien/adult/banda/carrier)
	for(var/index in 1 to 4)
		var/obj/item/clothing/mask/facehugger/hugger = allocate(/obj/item/clothing/mask/facehugger)
		TEST_ASSERT(carrier.store_hugger(hugger), "Cannot store hugger [index]")
		var/count = 0
		for(var/image/overlay as anything in carrier.overlays)
			if(findtext(overlay.icon_state, "clinger_") == 1)
				count++
		TEST_ASSERT_EQUAL(count, index, "Carrier appearance does not match stored huggers")
	carrier.set_resting(TRUE, instant = TRUE)
	for(var/image/overlay as anything in carrier.overlays)
		if(findtext(overlay.icon_state, "clinger_") == 1)
			TEST_ASSERT(findtext(overlay.icon_state, "Sleeping"), "Resting carrier shows standing huggers")
	var/obj/item/clothing/mask/facehugger/first = carrier.stored_huggers[1]
	qdel(first)
	TEST_ASSERT_EQUAL(length(carrier.stored_huggers), 3, "Deleted hugger remained in storage")

/datum/unit_test/xeno_rework_hive/enclosed_core/Run()
	var/mob/living/carbon/alien/adult/banda/queen/queen = allocate(/mob/living/carbon/alien/adult/banda/queen)
	allocate(/obj/structure/alien/weeds/node)
	var/obj/structure/xeno_hive_core/core = allocate(/obj/structure/xeno_hive_core)
	STOP_PROCESSING(SSobj, core)
	var/list/walls = list()
	for(var/turf/open/location in range(2, core))
		if(core.next_to_core(location))
			walls += allocate(/obj/structure/alien/resin/wall, location)
	hive.advance_brood(100, 60)
	TEST_ASSERT_EQUAL(hive.brood_points, 100, "Enclosed core lost points without creating an egg")
	TEST_ASSERT_EQUAL(core.available_brood(), 0, "Enclosed core created an egg in a wall")
	var/list/data = hive.ui_data(queen)
	TEST_ASSERT(data["broodBlocked"], "The menu hides an enclosed core's spawning obstruction")
	for(var/obj/structure/wall as anything in walls)
		qdel(wall)
	hive.advance_brood(0, 60)
	TEST_ASSERT_EQUAL(hive.brood_points, 0, "Clearing an egg spot did not spend accumulated points")
	TEST_ASSERT_EQUAL(core.available_brood(), 1, "Clearing an egg spot did not create the delayed egg")
