/datum/unit_test/xeno_rework_hive/birth_without_ghost/Run()
	var/mob/living/carbon/alien/adult/banda/drone/adult = allocate(/mob/living/carbon/alien/adult/banda/drone)
	var/mob/living/carbon/human/prey = allocate(/mob/living/carbon/human/consistent)
	var/obj/structure/bed/nest/banda/nest = allocate(/obj/structure/bed/nest/banda)
	var/obj/item/organ/body_egg/alien_embryo/embryo = allocate(/obj/item/organ/body_egg/alien_embryo, prey)
	hive.cocoon_time = 0
	TEST_ASSERT(nest.user_buckle_mob(prey, adult), "Infected prey could not be cocooned")
	embryo.stage = 6
	embryo.bursting = TRUE
	embryo.on_poll_concluded(TRUE, null)
	TEST_ASSERT(QDELETED(embryo), "No-ghost birth stalled with an embryo remaining")
	TEST_ASSERT(!QDELETED(prey) && prey.stat == DEAD && prey.buckled == nest, "Birth did not leave the intact body in its cocoon")
	var/mob/living/carbon/alien/larva/larva = locate() in prey.loc
	TEST_ASSERT_NOTNULL(larva, "No physical larva was born without a ghost")
	TEST_ASSERT_NOTNULL(larva.GetComponent(/datum/component/ghost_direct_control), "Unclaimed larva cannot be occupied later")
	TEST_ASSERT_EQUAL(hive.biomass, 50, "Birth paid the wrong reward")
	nest.cocoon.process(150)
	nest.cocoon.process(2)
	TEST_ASSERT(QDELETED(prey), "The post-birth corpse did not finish processing")
	TEST_ASSERT_EQUAL(hive.biomass, 100, "Post-birth processing exceeded the body budget")

/datum/unit_test/xeno_rework_hive/rest_and_skills/Run()
	for(var/caste in list(/mob/living/carbon/alien/adult/banda/runner, /mob/living/carbon/alien/brood))
		var/mob/living/carbon/alien/xeno = allocate(caste)
		var/datum/action/cooldown/alien/banda/sleepytime/rest = locate() in xeno.actions
		TEST_ASSERT_NOTNULL(rest, "Xeno has no Rest action")
		TEST_ASSERT(rest.PreActivate(xeno), "Xeno could not rest")
		TEST_ASSERT(xeno.resting && HAS_TRAIT(xeno, TRAIT_IMMOBILIZED), "Rest did not immobilize the xeno")
		TEST_ASSERT(!(xeno.mobility_flags & MOBILITY_MOVE), "Resting xeno could walk")
		TEST_ASSERT(rest.IsAvailable(), "Immobilization prevented standing up")
		TEST_ASSERT(rest.PreActivate(xeno), "Xeno could not stand")
		sleep(1.2 SECONDS)
		TEST_ASSERT(!xeno.resting && !HAS_TRAIT_FROM(xeno, TRAIT_IMMOBILIZED, "xeno_rest"), "Standing retained the Rest lock")
	var/mob/living/carbon/alien/adult/banda/queen/queen = allocate(/mob/living/carbon/alien/adult/banda/queen)
	TEST_ASSERT_NOTNULL(locate(/datum/action/cooldown/alien/hive_roster) in queen.actions, "Hive roster is missing from the skill bar")
	TEST_ASSERT_NOTNULL(locate(/datum/action/cooldown/alien/hive_development) in queen.actions, "Hive development is missing from the skill bar")
	queen.set_resting(TRUE)
	TEST_ASSERT(!hive.can_manage(queen), "Resting queen could buy upgrades")
	TEST_ASSERT(!hive.debug_resources(queen) && hive.biomass == 0 && !hive.debug_used, "Non-admin queen forged a debug grant")

/datum/unit_test/xeno_rework_hive/swallow_action/Run()
	var/mob/living/carbon/alien/adult/banda/drone/adult = allocate(/mob/living/carbon/alien/adult/banda/drone)
	var/mob/living/carbon/human/prey = allocate(/mob/living/carbon/human/consistent)
	var/datum/action/cooldown/alien/hive_swallow/swallow = locate() in adult.actions
	TEST_ASSERT_NOTNULL(swallow, "Adult has no dedicated swallow action")
	swallow.swallow_time = 0.3 SECONDS
	INVOKE_ASYNC(swallow, TYPE_PROC_REF(/datum/action/cooldown/alien/hive_swallow, PreActivate), prey)
	sleep(0.1 SECONDS)
	prey.forceMove(get_ranged_target_turf(adult, NORTH, 3))
	sleep(0.4 SECONDS)
	TEST_ASSERT(isturf(prey.loc), "Moving prey was swallowed after escaping")
	prey.forceMove(adult.loc)
	swallow.swallow_time = 0
	TEST_ASSERT(swallow.PreActivate(prey), "Adjacent prey could not be swallowed without a grab")
	var/obj/item/organ/stomach/alien_banda/stomach = adult.get_organ_slot(ORGAN_SLOT_STOMACH)
	TEST_ASSERT(prey in stomach.stomach_contents, "Swallow skipped the native stomach bookkeeping")
	stomach.empty_contents()
	TEST_ASSERT(isturf(prey.loc), "Swallowed prey could not be regurgitated")

/datum/unit_test/xeno_rework_hive/ability_swap_and_carrier/Run()
	var/mob/living/carbon/alien/adult/banda/spitter/spitter = allocate(/mob/living/carbon/alien/adult/banda/spitter)
	var/mob/living/carbon/alien/adult/banda/sentinel/sentinel = allocate(/mob/living/carbon/alien/adult/banda/sentinel)
	TEST_ASSERT_NOTNULL(locate(/datum/action/cooldown/alien/banda/acid_spray) in spitter.actions, "Spitter did not inherit acid spray")
	TEST_ASSERT_NULL(locate(/datum/action/cooldown/alien/banda/toxic_sting) in spitter.actions, "Spitter retained toxic sting")
	TEST_ASSERT_NOTNULL(locate(/datum/action/cooldown/alien/banda/toxic_sting) in sentinel.actions, "Sentinel did not inherit toxic sting")
	TEST_ASSERT_NULL(locate(/datum/action/cooldown/alien/banda/acid_spray) in sentinel.actions, "Sentinel retained acid spray")
	var/mob/living/carbon/alien/adult/banda/praetorian/praetorian = allocate(/mob/living/carbon/alien/adult/banda/praetorian)
	TEST_ASSERT_NULL(locate(/datum/action/cooldown/alien/banda/hive_pheromones) in praetorian.actions, "Praetorian has healing before its purchase")
	var/mob/living/carbon/alien/adult/banda/drone/drone = allocate(/mob/living/carbon/alien/adult/banda/drone)
	TEST_ASSERT(!drone.can_evolve(/mob/living/carbon/alien/adult/banda/carrier), "Carrier is open before purchase")
	hive.purchased["carrier"] = 1
	TEST_ASSERT(drone.can_evolve(/mob/living/carbon/alien/adult/banda/carrier), "Carrier did not unlock from Drone")
	var/mob/living/carbon/alien/adult/banda/carrier/carrier = allocate(/mob/living/carbon/alien/adult/banda/carrier)
	var/obj/item/clothing/mask/facehugger/hugger = allocate(/obj/item/clothing/mask/facehugger)
	TEST_ASSERT(carrier.store_hugger(hugger), "Carrier cannot store a native facehugger")
	TEST_ASSERT(hugger in carrier.stored_huggers, "Carrier lost its stored item")
	hugger.forceMove(carrier.loc)
	TEST_ASSERT(!(hugger in carrier.stored_huggers), "Moving a hugger left a stale storage reference")
	TEST_ASSERT(carrier.store_hugger(hugger), "Carrier could not store its dropped hugger")
	carrier.death()
	TEST_ASSERT(!length(carrier.stored_huggers) && isturf(hugger.loc), "Carrier death retained hidden facehuggers")

/datum/unit_test/xeno_rework_hive/illusion_values/Run()
	var/mob/living/carbon/alien/adult/banda/runner/original = allocate(/mob/living/carbon/alien/adult/banda/runner)
	var/mob/living/basic/illusion/illusion = allocate(/mob/living/basic/illusion)
	illusion.full_setup(original, hp = 25, damage = 2, replicate = 35)
	TEST_ASSERT_EQUAL(illusion.maxHealth, 25, "Explicit illusion health was ignored")
	TEST_ASSERT_EQUAL(illusion.melee_damage_upper, 2, "Explicit illusion damage was ignored")
	TEST_ASSERT_EQUAL(illusion.multiply_chance, 35, "Explicit illusion replication chance was ignored")
	illusion.mock_as(original, 10 SECONDS, null, 0, 0)
	TEST_ASSERT_EQUAL(illusion.maxHealth, 25, "Null health overwrote the existing value")
	TEST_ASSERT_EQUAL(illusion.melee_damage_upper, 0, "Zero-damage decoy inherited damage")
	TEST_ASSERT_EQUAL(illusion.multiply_chance, 0, "Zero replication inherited a chance to multiply")

/datum/unit_test/xeno_rework_hive/generator
	normal_floor_required = TRUE

/datum/unit_test/xeno_rework_hive/generator/Run()
	var/mob/living/carbon/alien/adult/banda/queen/queen = allocate(/mob/living/carbon/alien/adult/banda/queen)
	queen.setDir(NORTH)
	hive.biomass = 1200
	hive.purchase_time = 0
	TEST_ASSERT(hive.buy(queen, "generator"), "Could not buy a generator on four free floors")
	var/obj/structure/xeno_biomass_generator/generator = locate() in hive.hive_structure_location(queen)
	TEST_ASSERT_NOTNULL(generator, "Generator purchase made no physical structure")
	STOP_PROCESSING(SSobj, generator)
	TEST_ASSERT_EQUAL(hive.biomass, 600, "Generator cost was not charged exactly once")
	TEST_ASSERT(generator.density && generator.bound_width == 64 && generator.bound_height == 64, "Generator is not an impassable 2x2 structure")
	TEST_ASSERT(!hive.buy(queen, "generator"), "Generator overlapped an occupied footprint")
	var/mob/living/carbon/human/walker = allocate(/mob/living/carbon/human/consistent)
	walker.forceMove(locate(generator.x + 2, generator.y, generator.z))
	TEST_ASSERT(!walker.Move(get_step(walker, WEST), WEST), "The generator's southeast tile is passable")
	walker.forceMove(locate(generator.x + 2, generator.y + 1, generator.z))
	TEST_ASSERT(!walker.Move(get_step(walker, WEST), WEST), "The generator's northeast tile is passable")
	walker.forceMove(locate(generator.x, generator.y + 2, generator.z))
	TEST_ASSERT(!walker.Move(get_step(walker, SOUTH), SOUTH), "The generator's northwest tile is passable")
	qdel(walker)
	generator.process(100)
	generator.process(500)
	TEST_ASSERT_EQUAL(hive.biomass, 1200, "Generator did not repay its cost in exactly ten minutes")
	qdel(generator)
	TEST_ASSERT(hive.buy(queen, "generator"), "A repeatable generator could not be bought again")

/datum/unit_test/xeno_rework_hive/charge_walls/Run()
	var/mob/living/carbon/alien/adult/banda/final_caste/crusher/crusher = allocate(/mob/living/carbon/alien/adult/banda/final_caste/crusher)
	crusher.setDir(NORTH)
	crusher.adjustPlasma(crusher.get_max_plasma())
	for(var/index in 1 to 14)
		crusher.Moved(get_step(crusher, SOUTH), NORTH, FALSE)
	TEST_ASSERT_EQUAL(crusher.momentum, 14, "Crusher did not build fourteen charge steps")
	TEST_ASSERT(abs(crusher.charge_speed() - 2.1) < 0.001, "Crusher acceleration differs from TGMC")
	crusher.lose_momentum(2)
	TEST_ASSERT_EQUAL(crusher.momentum, 12, "Object impact did not remove two steps")
	crusher.setDir(EAST)
	TEST_ASSERT_EQUAL(crusher.momentum, 0, "Turning did not immediately cancel charge")
	crusher.momentum = 10
	crusher.set_resting(TRUE)
	TEST_ASSERT_EQUAL(crusher.momentum, 0, "Rest retained charge speed")
	var/turf/target = get_step(run_loc_floor_bottom_left, NORTH)
	var/turf/closed/wall/r_wall/wall = target.ChangeTurf(/turf/closed/wall/r_wall)
	wall.xeno_charge_impact(TRUE)
	TEST_ASSERT(istype(locate(target.x, target.y, target.z), /turf/closed/wall/r_wall), "One maximum charge instantly broke a reinforced wall")
	wall.xeno_charge_impact(TRUE)
	TEST_ASSERT(!istype(locate(target.x, target.y, target.z), /turf/closed/wall), "Repeated maximum charge did not breach reinforced wall")
	var/turf/replacement = locate(target.x, target.y, target.z)
	replacement.ChangeTurf(/turf/open/indestructible)

/datum/unit_test/xeno_rework_hive/role_registry/Run()
	var/obj/structure/xeno_hive_egg/egg = allocate(/obj/structure/xeno_hive_egg)
	var/obj/effect/mob_spawn/ghost_role/xeno_hive/spawner = egg.spawner
	spawner.uses = 1
	var/mob/dead/observer/ghost = allocate(/mob/dead/observer)
	var/datum/spawners_menu/menu = allocate(/datum/spawners_menu, ghost)
	var/datum/tgui/ui = allocate(/datum/tgui, ghost, menu, "SpawnersMenu")
	TEST_ASSERT(spawner in GLOB.mob_spawners[spawner.name], "Clutch was never registered as a native ghost role")
	TEST_ASSERT(!spawner.allow_spawn(ghost), "Uninstalled clutch unexpectedly permits spawning")
	menu.ui_act("jump", list("name" = spawner.name), ui)
	TEST_ASSERT(spawner in GLOB.mob_spawners[spawner.name], "Filtering a temporarily unavailable clutch erased the shared role registry")

/datum/unit_test/xeno_rework_hive/core_crew_processing/Run()
	var/mob/living/carbon/alien/adult/banda/queen/queen = allocate(/mob/living/carbon/alien/adult/banda/queen)
	allocate(/obj/structure/alien/weeds/node)
	var/obj/structure/xeno_hive_core/core = allocate(/obj/structure/xeno_hive_core)
	STOP_PROCESSING(SSobj, core)
	var/mob/living/carbon/human/crew = allocate(/mob/living/carbon/human/consistent)
	crew.mind_initialize()
	crew.mind.set_assigned_role(SSjob.get_job_type(/datum/job/assistant))
	var/expected = hive.brood_rate(hive.count_crew())
	TEST_ASSERT(expected > 0, "A living crew member was not counted")
	core.process(60)
	TEST_ASSERT(abs(hive.brood_points - expected) < 0.001, "Installed core did not accrue passive points from actual crew")
	var/list/data = hive.ui_data(queen)
	TEST_ASSERT_EQUAL(data["broodRate"], expected, "Queen menu does not expose actual passive rate")
	core.process(6000)
	TEST_ASSERT(core.available_brood() > 0, "Core processing never produced a persistent ghost-role place")

/datum/unit_test/xeno_rework_hive/beetle_collision/Run()
	hive.purchased["beetle_charge"] = 1
	var/mob/living/carbon/alien/brood/beetle = allocate(/mob/living/carbon/alien/brood)
	var/mob/living/carbon/human/prey = allocate(/mob/living/carbon/human/consistent, get_step(beetle, NORTH))
	var/datum/action/cooldown/alien/brood_charge/charge = locate() in beetle.actions
	TEST_ASSERT(charge.PreActivate(get_ranged_target_turf(beetle, NORTH, 3)), "Unlocked beetle could not charge toward a turf")
